<div class="hw-scroll standard-form hw-races">
  <p class="hint">
    Enter each race's listed characteristics. A character's maxima are these +10 (SPD +1, OCV/DCV/OMCV/DMCV +2),
    averaged across the character's races and rounded up. Leave a value blank if the race doesn't list it.
  </p>

  {{#if editable}}
  <div class="hw-toolbar">
    <button type="button" data-action="addRace"><i class="fa-solid fa-plus" inert></i> Add race</button>
    <span class="hw-toolbar-gap"></span>
    <select name="importActor" aria-label="Actor to import">
      <option value="">Import from actor…</option>
      {{#each actors}}<option value="{{id}}">{{name}}</option>{{/each}}
    </select>
    <button type="button" data-action="importActor"><i class="fa-solid fa-user" inert></i> Import</button>
    <button type="button" data-action="importFile"><i class="fa-solid fa-file-import" inert></i> Import rules file…</button>
  </div>
  {{/if}}

  {{#if races.length}}
  <table class="hw-race-table">
    <thead>
      <tr>
        <th>Race</th>
        {{#each columns}}<th>{{this}}</th>{{/each}}
        {{#if editable}}<th></th>{{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each races as |race|}}
      <tr>
        <td><input type="text" data-field="race.{{race.id}}.name" value="{{race.name}}" {{#unless ../editable}}disabled{{/unless}}></td>
        {{#each race.stats as |stat|}}
        <td data-tooltip="{{stat.tooltip}}">
          <input type="number" data-field="race.{{race.id}}.{{stat.type}}" value="{{stat.value}}" {{#unless ../../editable}}disabled{{/unless}}>
        </td>
        {{/each}}
        {{#if ../editable}}
        <td><a data-action="deleteRace" data-race-id="{{race.id}}" data-tooltip="Delete race"><i class="fa-solid fa-trash" inert></i></a></td>
        {{/if}}
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="hint hw-empty">No races yet.</p>
  {{/if}}
</div>
