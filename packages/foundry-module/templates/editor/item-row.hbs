<li class="hw-item {{#if row.isGroup}}hw-item-group{{/if}} {{#if (eq row.carried false)}}hw-stored{{/if}} {{#if row.collapsed}}hw-collapsed{{/if}}">
  <div class="hw-item-row" draggable="true" tabindex="0" role="button" data-action="editItem" data-section="{{section}}"
    data-item-id="{{row.id}}" {{#if row.acceptsChildren}}data-accepts-children{{/if}} {{#if row.container}}data-container="{{row.container}}"{{/if}} {{#if row.acceptsParts}}data-accepts-parts{{/if}}>
    {{#if row.children.length}}
    <a class="hw-item-collapse" data-action="toggleCollapse" data-section="{{section}}" data-item-id="{{row.id}}" data-tooltip="{{#if row.collapsed}}Open{{else}}Close{{/if}}"
      aria-expanded="{{#if row.collapsed}}false{{else}}true{{/if}}" aria-label="Open or close {{row.name}}"><i class="fa-solid fa-chevron-down" inert></i></a>
    {{else if collapsible}}
    <span class="hw-item-collapse-spacer"></span>
    {{/if}}
    <img class="hw-item-icon" src="{{row.img}}" alt="" loading="lazy">
    <div class="hw-item-text">
      <span class="hw-item-name">{{#if (or row.quantity (eq row.quantity 0))}}<span class="hw-item-qty" data-tooltip="How many">{{row.quantity}} ×</span> {{/if}}{{row.name}}{{#if row.children.length}} <span class="hw-item-inside hint" data-tooltip="Items in it">({{row.inside}})</span>{{/if}}{{#if row.free}} <span class="hw-tag hw-tag-free" data-tooltip="Given by the GM: costs no points">Free</span>{{/if}}</span>
      {{#if row.detail}}<span class="hint hw-item-detail">{{row.detail}}</span>{{/if}}
    </div>
    {{#if (eq section "skills")}}
    <span class="hw-item-roll" data-tooltip="Roll">{{#if row.roll}}{{row.roll}}{{/if}}</span>
    {{/if}}
    {{#if (eq section "equipment")}}
    <span class="hw-item-price" data-tooltip="{{#if (or row.quantity (eq row.quantity 0))}}Price each{{else}}Price{{/if}}">{{#if row.price}}{{row.price}}{{/if}}</span>
    {{#if row.contents}}
    <span class="hw-item-weight" data-tooltip="What's in it: {{row.contents.carried}} kg carried, {{row.contents.stored}} kg stored">{{#if row.contents.carried}}{{row.contents.carried}} kg{{else if row.contents.stored}}({{row.contents.stored}} kg){{/if}}</span>
    {{else}}
    <span class="hw-item-weight" data-tooltip="{{#if (or row.quantity (eq row.quantity 0))}}Weight of all {{row.quantity}}{{else}}Weight{{/if}}">{{#if row.weight}}{{row.weight}} kg{{/if}}</span>
    {{/if}}
    {{/if}}
    <span class="hw-item-cost" {{#if (eq section "equipment")}}data-tooltip="Real Cost"{{/if}}>{{row.cost}}</span>
    {{#if (and canCarry (or (eq row.carried true) (eq row.carried false)))}}
    <a class="hw-item-carry" data-action="toggleCarried" data-item-id="{{row.id}}"
      data-tooltip="{{#if row.carried}}Carried{{#if row.contents}} (with what's in it){{/if}}: click to store it{{else}}Stored, not carried: click to carry it{{/if}}"
      aria-label="{{#if row.carried}}Store{{else}}Carry{{/if}} {{row.name}}"><i class="fa-solid {{#if row.carried}}fa-hand-holding{{else}}fa-box-archive{{/if}}" inert></i></a>
    {{/if}}
    {{#if (and canMove (or (eq row.carried true) (eq row.carried false)))}}
    <a class="hw-item-move" data-action="moveToActor" data-item-id="{{row.id}}" data-tooltip="Move to another actor (a stash, a mount, another character)" aria-label="Move {{row.name}} to another actor"><i class="fa-solid fa-right-left" inert></i></a>
    {{/if}}
    <a class="hw-item-delete" data-action="deleteItem" data-section="{{section}}" data-item-id="{{row.id}}" data-tooltip="Delete" aria-label="Delete {{row.name}}"><i class="fa-solid fa-trash" inert></i></a>
  </div>
  {{#if row.children.length}}
  <ol class="hw-items hw-children">
    {{#each row.children as |child|}}{{> "modules/hero-workshop/templates/editor/item-row.hbs" row=child section=../section canCarry=../canCarry canMove=../canMove collapsible=../collapsible}}{{/each}}
  </ol>
  {{/if}}
</li>
