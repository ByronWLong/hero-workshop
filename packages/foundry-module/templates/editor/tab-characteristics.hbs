<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="characteristics">
  {{#if tab.str}}
  <div class="hw-derived">
    <div><span class="hint">Lift</span><strong>{{tab.str.lift}}</strong></div>
    <div><span class="hint">HTH damage</span><strong>{{tab.str.damage}}</strong></div>
    <div><span class="hint">Throw</span><strong>{{tab.str.throw}}</strong></div>
  </div>
  {{/if}}

  {{#if tab.usesMaxima}}
  <fieldset class="hw-maxima">
    <legend>Characteristic maxima</legend>
    <div class="hw-maxima-head">
      <span class="hint">
        {{#if tab.races.length}}Races: {{#each tab.races}}{{this}}{{#unless @last}} / {{/unless}}{{/each}}
        {{else}}No races chosen. Levels above a maximum cost double.{{/if}}
      </span>
      <div class="hw-inline-buttons">
        {{#if tab.canManageRaces}}
        <button type="button" data-action="manageRaces"><i class="fa-solid fa-dna" inert></i> Race library</button>
        {{/if}}
        <button type="button" data-action="chooseRaces"><i class="fa-solid fa-people-group" inert></i> Choose races</button>
      </div>
    </div>
    <div class="hw-maxima-grid">
      {{#each tab.maxima}}
      <label class="hw-maxima-cell">
        <span>{{type}}</span>
        <input type="number" data-field="max.{{type}}" value="{{value}}" placeholder="—">
      </label>
      {{/each}}
    </div>
  </fieldset>
  {{/if}}

  {{#each tab.groups as |group|}}
  <h3 class="hw-group-title">{{group.label}}</h3>
  <div class="hw-char-grid">
    {{#each group.stats as |stat|}}
    <div class="hw-char {{#if stat.over}}hw-over{{/if}}">
      <label class="hw-char-name" for="hw-char-{{stat.type}}">{{stat.label}}</label>
      <div class="hw-char-effective">
        {{stat.effective}}{{#if stat.unit}}<small>{{stat.unit}}</small>{{/if}}{{#if stat.resistant}}<small class="hw-resistant">/{{stat.resistant}}r</small>{{/if}}
      </div>
      <div class="hw-char-value">
        <input id="hw-char-{{stat.type}}" type="number" data-field="char.{{stat.type}}" value="{{stat.value}}">
        {{#if stat.bonus}}<span class="hint">({{#if (gt stat.bonus 0)}}+{{/if}}{{stat.bonus}})</span>{{/if}}
      </div>
      {{#if stat.roll}}<div class="hint">Roll {{stat.roll}}</div>{{/if}}
      {{#if stat.maximum}}
      <div class="hw-char-max">Max {{stat.maximum}}{{#if stat.surcharge}} · +{{stat.surcharge}} pts over{{/if}}</div>
      {{/if}}
      <div class="hw-char-cost">{{stat.cost}} pts</div>
    </div>
    {{/each}}
  </div>
  {{/each}}
</section>
