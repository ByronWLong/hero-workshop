<section class="tab hw-list-tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
  <div class="hw-list-toolbar">
    <span class="hint">{{tab.count}} {{#if (eq tab.count 1)}}entry{{else}}entries{{/if}} · {{tab.points}} pts</span>
    {{#if tab.canCollapse}}
    <a class="hw-collapse-all" data-action="collapseAll" data-section="{{tab.section}}" data-tooltip="{{#if tab.allCollapsed}}Open every list{{else}}Close every list, compound and framework{{/if}}">
      <i class="fa-solid {{#if tab.allCollapsed}}fa-folder-open{{else}}fa-folder-closed{{/if}}" inert></i> {{#if tab.allCollapsed}}Open all{{else}}Close all{{/if}}</a>
    {{/if}}
    {{#if tab.canAdd}}
    <div class="hw-inline-buttons hw-add-bar">
      {{#if tab.addChoices}}
      {{> "modules/hero-workshop/templates/partials/typeahead.hbs" field=tab.addField clear=true groups=tab.addChoices placeholder=tab.addPlaceholder icon="fa-plus" cssClass="hw-add-typeahead"}}
      {{/if}}
      <button type="button" data-action="addItem" data-section="{{tab.section}}"><i class="fa-solid fa-plus" inert></i> Add {{tab.noun}}</button>
      {{#if tab.canAddList}}
      <button type="button" data-action="addItem" data-section="{{tab.section}}" data-type="LIST" data-tooltip="A heading to group {{tab.noun}}s under"><i class="fa-solid fa-folder-plus" inert></i> Add list</button>
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{#if tab.load}}
  <p class="hint hw-load {{#if tab.load.dcv}}hw-bad{{/if}}" data-tooltip="As hero6e works out encumbrance: carried weight against what STR lifts">
    <i class="fa-solid fa-weight-hanging" inert></i> {{tab.load.text}}{{#if tab.load.stored}} · <i class="fa-solid fa-box-archive" inert></i> {{tab.load.stored}}{{/if}}
  </p>
  {{/if}}
  {{#if tab.money}}
  <div class="hw-money" data-no-steppers>
    <span class="hint" data-tooltip="Coins are equipment: one item per currency, its quantity the count. The GM sets the currencies in Hero Workshop's settings."><i class="fa-solid fa-coins" inert></i> Money</span>
    {{#each tab.money.rows as |coin|}}
    <label class="hw-money-coin" data-tooltip="{{coin.tooltip}}">
      {{#if coin.img}}<img src="{{coin.img}}" alt="">{{/if}}
      <input type="number" min="0" step="1" data-field="money.{{coin.index}}" value="{{coin.count}}" aria-label="{{coin.name}}" {{#unless ../tab.money.editable}}disabled{{/unless}}>
      <span>{{coin.abbreviation}}</span>
    </label>
    {{/each}}
    {{#if tab.money.total}}<span class="hint hw-money-total">worth {{tab.money.total}}</span>{{/if}}
  </div>
  {{/if}}
  {{#if tab.rows.length}}
  <ol class="hw-items">
    {{#each tab.rows as |row|}}{{> "modules/hero-workshop/templates/editor/item-row.hbs" row=row section=../tab.section canCarry=../tab.canCarry canMove=../tab.canMove collapsible=../tab.canCollapse}}{{/each}}
  </ol>
  {{else}}
  <p class="hint hw-empty">Nothing here yet. Add one, or drag items in from the Items sidebar.</p>
  {{/if}}
</section>
