<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
  <div class="hw-list-toolbar">
    {{#if (eq tab.section "powers")}}
    <button type="button" data-action="addItem" data-section="powers" data-kind="list">
      <i class="fa-solid fa-folder-plus" inert></i> Add list
    </button>
    <button type="button" data-action="addItem" data-section="powers" data-kind="compound">
      <i class="fa-solid fa-layer-group" inert></i> Add compound power
    </button>
    {{/if}}
    <button type="button" data-action="addItem" data-section="{{tab.section}}">
      <i class="fa-solid fa-plus" inert></i> Add
    </button>
  </div>
  {{#if tab.rows.length}}
  <ol class="hw-items">
    {{#each tab.rows as |row|}}{{> "modules/hero-workshop/templates/editor/item-row.hbs" row=row section=../tab.section}}{{/each}}
  </ol>
  {{else}}
  <p class="hint hw-empty">Nothing here yet.</p>
  {{/if}}
</section>
