<div class="hw-picker standard-form">
  {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}

  <div class="hw-toolbar">
    <input type="search" data-search="actors" placeholder="Search actors and compendiums…" aria-label="Search actors" autofocus>
  </div>

  {{#if any}}
  <ul class="hw-pick-list" data-search-list="actors">
    {{#if (and actors.length compendiums.length)}}<li class="hw-pick-heading" data-search-text="">World actors</li>{{/if}}
    {{#each actors}}{{> actorChoice}}{{/each}}
    {{#each compendiums}}
    <li class="hw-pick-heading" data-search-text="">{{label}}</li>
    {{#each actors}}{{> actorChoice}}{{/each}}
    {{/each}}
  </ul>
  <p class="hint hw-empty" data-search-empty="actors" hidden>No actors match.</p>
  {{else}}
  <p class="hint hw-empty">There are no actors in this world or its compendiums.</p>
  {{/if}}
</div>

{{#*inline "actorChoice"}}
<li class="hw-pick-actor" data-search-text="{{searchText}}" data-action="choose" data-actor-id="{{id}}" role="button" tabindex="0">
  <img src="{{img}}" alt="" loading="lazy">
  <span class="hw-pick-name">
    <span>{{name}}</span>
    <span class="hint">{{detail}}{{#unless hasHdc}} · no Hero Designer data{{/unless}}</span>
  </span>
</li>
{{/inline}}
