<div class="hw-scroll standard-form hw-dialog-body">
  {{#if iconOnly}}{{> "modules/hero-workshop/templates/partials/identity.hbs" label="Icon" icon=icon}}{{/if}}
  {{#each fields as |field|}}
  {{#if field.identity}}
  {{> "modules/hero-workshop/templates/partials/identity.hbs" field.identity}}
  {{else if field.typeahead}}
  <div class="form-group">
    <label>{{field.label}}</label>
    <div class="form-fields">
      {{> "modules/hero-workshop/templates/partials/typeahead.hbs" field=field.name text=field.typeahead.text groups=field.typeahead.groups placeholder=field.typeahead.placeholder ariaLabel=field.label}}
    </div>
    {{#if field.hint}}<p class="hint">{{field.hint}}</p>{{/if}}
  </div>
  {{else}}
  <div class="form-group {{#if (or (eq field.type "textarea") (eq field.type "attacks"))}}stacked{{/if}}">
    <label for="hw-field-{{field.name}}">{{field.label}}</label>
    <div class="form-fields">
      {{#if (eq field.type "select")}}
      <select id="hw-field-{{field.name}}" name="{{field.name}}" data-field="{{field.name}}">
        {{#each field.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{else if (eq field.type "attacks")}}
      <div class="hw-attacks">
        {{#each field.groups as |group|}}
        <h4 class="hw-attack-group">{{group.name}}</h4>
        {{#each group.options}}
        <label class="checkbox"><input type="checkbox" data-attack="{{value}}" {{checked selected}}> {{label}}{{#if detail}} <span class="hint">({{detail}})</span>{{/if}}</label>
        {{/each}}
        {{else}}
        <p class="hint">This character has no attacks yet.</p>
        {{/each}}
        <div class="hw-attack-other">
          <input type="text" placeholder="Other attack or maneuver, e.g. Strike" aria-label="Other attack or maneuver">
          <button type="button" data-action="addAttack"><i class="fa-solid fa-plus" inert></i> Add</button>
        </div>
      </div>
      {{else if (eq field.type "checkbox")}}
      <input id="hw-field-{{field.name}}" type="checkbox" name="{{field.name}}" data-field="{{field.name}}" {{checked field.value}}>
      {{else if (eq field.type "textarea")}}
      <textarea id="hw-field-{{field.name}}" name="{{field.name}}" data-field="{{field.name}}" rows="3">{{field.value}}</textarea>
      {{else}}
      <input id="hw-field-{{field.name}}" type="{{field.type}}" name="{{field.name}}" data-field="{{field.name}}" value="{{field.value}}">
      {{/if}}
    </div>
    {{#if field.hint}}<p class="hint">{{field.hint}}</p>{{/if}}
  </div>
  {{/if}}
  {{/each}}
</div>
