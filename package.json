{
  "name": "hero-workshop",
  "version": "1.0.0",
  "description": "Hero Workshop - a HERO System 6e character editor module for Foundry VTT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @hero-workshop/shared && npm run build -w @hero-workshop/foundry-module",
    "build:shared": "npm run build -w @hero-workshop/shared",
    "lint": "eslint packages/shared/src packages/foundry-module/src",
    "lint:fix": "eslint packages/shared/src packages/foundry-module/src --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,json,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rimraf packages/*/dist packages/*/node_modules node_modules",
    "build:foundry": "npm run build -w @hero-workshop/foundry-module",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
